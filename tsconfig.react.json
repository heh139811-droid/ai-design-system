{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "declaration": true,
    "outDir": "dist/react", "rootDir": "src/react", "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "types": ["react", "react-dom"]
  },
  "include": ["src/react/**/*.tsx", "src/react/**/*.ts"]
}
